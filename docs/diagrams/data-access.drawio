<mxfile host="app.diagrams.net" agent="ajipita-inside" version="24.7.17">
  <diagram name="データアクセス境界" id="ajipita-bff">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="データアクセス境界（BFF）"
          style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1F2933;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ロジックの置き場所は 1 箇所。到達方法だけを用途ごとに分ける"
          style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#616E7C;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- クライアント -->
        <mxCell id="clientBox" value="クライアント"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCFAFF;strokeColor=#9B8AC4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#4A3A6B;"
          vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cc" value="&lt;b&gt;Client Component&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#4A3A6B;&quot;&gt;ブラウザ&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C5CD6;fontColor=#3B2A78;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="350" y="140" width="195" height="60" as="geometry" />
        </mxCell>
        <mxCell id="native" value="&lt;b&gt;ネイティブアプリ&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#616E7C;&quot;&gt;（将来）&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#374151;fontSize=12;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- サーバー -->
        <mxCell id="serverBox" value="サーバー"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#3B6FD4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#12305E;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="880" height="290" as="geometry" />
        </mxCell>

        <mxCell id="rsc" value="&lt;b&gt;Server Component&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#616E7C;&quot;&gt;画面の描画&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#374151;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="230" height="64" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API ルートハンドラ&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#616E7C;&quot;&gt;薄い HTTP アダプタ&lt;br/&gt;認証・入力検証・エラー整形のみ&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#374151;fontSize=12;"
          vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="290" height="64" as="geometry" />
        </mxCell>

        <mxCell id="module" value="&lt;b&gt;データモジュール&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#2A4E8A;&quot;&gt;ロジックの単一実体・ここにだけ DB アクセスがある&lt;br/&gt;server-only（クライアントに混入したらビルドが落ちる）&lt;/font&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EEFC;strokeColor=#3B6FD4;strokeWidth=2;fontColor=#12305E;fontSize=14;"
          vertex="1" parent="1">
          <mxGeometry x="240" y="460" width="500" height="76" as="geometry" />
        </mxCell>

        <!-- DB -->
        <mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#2A4E8A;&quot;&gt;RLS で行レベル制御&lt;/font&gt;"
          style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#E8EEFC;strokeColor=#3B6FD4;fontColor=#12305E;fontSize=13;"
