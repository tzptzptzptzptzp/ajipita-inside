          <mxGeometry x="370" y="630" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- 接続 -->
        <mxCell id="e_cc_api" value="fetch"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C5CD6;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;fontSize=11;fontColor=#3B2A78;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cc" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_native_api" value="同じ API"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;fontSize=11;fontColor=#616E7C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="native" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rsc_mod" value="直接呼ぶ&#10;（自己 HTTP しない）"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B6FD4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;fontSize=11;fontColor=#12305E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rsc" target="module">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_api_mod" value="呼ぶ"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B6FD4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;fontSize=11;fontColor=#12305E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="module">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mod_db"
          style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3B6FD4;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="module" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 注記 -->
        <mxCell id="note" value="Server Component が自分自身の API を fetch するのはアンチパターン。&#10;同じサーバー上にあるのに HTTP の往復を挟むことになる。&#10;そこで「ロジックの置き場所」と「到達方法」を分けた。"
          style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#616E7C;"
          vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="560" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
